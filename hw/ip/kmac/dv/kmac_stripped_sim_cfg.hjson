// sim cfg file for the stripped version of KMAC
{
  // Name of the sim cfg variant
  variant: stripped

  // Import additional common sim cfg files.
  // The tests requiring the keyed MAC (kmac_keyed_tests.hjson) are not imported as the KMAC
  // functionality is stripped off in this variant.
  import_cfgs: ["{proj_root}/hw/ip/kmac/dv/kmac_base_sim_cfg.hjson",
                "{proj_root}/hw/ip/kmac/dv/kmac_tests.hjson"]

  // Enable this build mode for all tests
  en_build_modes: ["stripped_down_kmac"]

}
