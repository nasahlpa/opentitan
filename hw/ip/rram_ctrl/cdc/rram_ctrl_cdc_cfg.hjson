{
  // Top level dut name (sv module).
  name: rram_ctrl

  // Fusesoc core file used for building the file list.
  fusesoc_core: lowrisc:ip:rram_ctrl:0.1

  import_cfgs: [// Project wide common CDC config file
                "{proj_root}/hw/cdc/tools/dvsim/common_cdc_cfg.hjson"]

  tool: meridiancdc

  // Timing constraints for this block. Defines the two asynchronous clock
  // domains (main clk_i and OTP clk_otp_i) so the OTP crossing is analyzed.
  sdc_file: [
    "{proj_root}/hw/ip/rram_ctrl/cdc/constraints.sdc",
  ]

  // Main CDC waiver file
  cdc_waiver_file: ""

  // CDC customized env file
  cdc_env_file: "{proj_root}/hw/ip/rram_ctrl/cdc/user_intent.env"

  // CDC customized configuration file (to be sourced after customized env)
  cdc_config_file: "{proj_root}/hw/ip/rram_ctrl/cdc/user_configuration.tcl"

  // Technology path for this module (empty for open-source runs)
  foundry_root: ""

  // Technology specific timing constraints for this module (empty for open-source runs)
  foundry_sdc_file: ""
}
